  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bnon (?:è|sono) (?:solo|soltanto|solamente|semplicemente|più che) [^.!?\\n]{2,60}[,.;]\\s*(?:è|sono|ma)\\b",
      "name": "\"Non è solo X, è Y\"",
      "fix": "Di' la cosa che intendi davvero. Cancella la metà di preparazione."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnon (?:solo|soltanto|solamente)\\b[^.!?\\n]{2,80}\\bma anche\\b",
      "name": "\"Non solo X ma anche Y\"",
      "fix": "Dividi in due frasi, oppure togli la metà più debole."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\bnon (?:si tratta|è una questione) di [^.!?\\n]{2,60}[.!,]\\s*(?:si tratta|è una questione) di\\b|\\bnon riguarda [^.!?\\n]{2,60}[.!]\\s*riguarda\\b",
      "name": "\"Non si tratta di X. Si tratta di Y.\"",
      "fix": "Parti da Y. Il ribaltamento è proprio il segnale."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:il risultato|la parte migliore|il bello|il colpo di scena|la sorpresa|il trucco|il segreto)\\?\\s*$",
      "name": "Riga con domanda retorica di una parola",
      "fix": "Rispondi nella frase invece di mettere in scena la rivelazione."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\becco (?:cosa|quello che) ho (?:imparato|scoperto)\\b",
      "name": "\"Ecco cosa ho imparato\"",
      "fix": "Scrivi la lezione. Salta l'annuncio."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
      "name": "Triade \"X, Y e Z\"",
      "fix": "Due elementi o quattro. Tre è il ritmo di default del modello."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji razzo / fuoco / lampadina / scintille / bersaglio",
      "fix": "Una emoji al massimo, e non una di queste cinque."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro di hashtag (5+)",
      "fix": "Tre hashtag bastano. Instagram dal 18 dicembre 2025 ne accetta al massimo 5 e non premia il muro."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bcome (?:un )?(?:modello linguistico|assistente ia|ia)\\b|\\bin quanto (?:ia|intelligenza artificiale|modello linguistico)\\b",
      "name": "Autoriferimento del modello",
      "fix": "Cancella la frase."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in sintesi|in conclusione|per riassumere|riassumendo|per concludere|in definitiva)\\b",
      "name": "Apertura da chiusa di tema",
      "fix": "Un post non ha bisogno di un paragrafo conclusivo."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)(?:sei d'accordo\\?|che ne pensi\\?|cosa ne pensi\\?|e tu\\?|e voi\\?|chi altro\\b[^.!?\\n]*\\?|sbaglio\\?)\\s*$",
      "name": "Esca di engagement da riflesso",
      "fix": "Fai una domanda che puoi fare solo tu, sulla cosa specifica scritta sopra."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:fermati(?: un (?:attimo|secondo|momento))?|ferma(?: lo)? scroll(?:ing)?|non scrollare|smetti di scrollare|basta scrollare|non scorrere)\\b",
      "name": "Apertura \"fermati / non scrollare\"",
      "fix": "Lo stop allo scroll deve essere l'affermazione stessa. Chiedere attenzione è il segnale che non te la sei guadagnata."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)\\b(?:in quest[oa] (?:video|reel|post)|nel (?:video|reel|post) di oggi|oggi (?:ti|vi) (?:mostro|spiego|insegno|parlo|racconto)|(?:ti|vi) (?:mostro|insegno|spiego) come)\\b",
      "name": "Preambolo da video (\"in questo video ti mostro\")",
      "fix": "Cancellalo e parti dal punto forte. I primi due secondi decidono tutto il reel."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Elenco puntato con emoji",
      "fix": "Usa un trattino o un a capo. Le emoji come puntini sono la cosa che sa più di modello in una didascalia."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-ZÀ-Þ]{3,}\\b(?:\\s+\\b[A-ZÀ-Þ]{3,}\\b){2,}",
      "name": "Tre o più parole in maiuscolo di fila",
      "fix": "Il maiuscolo è una manopola del volume, non un evidenziatore. Una parola al massimo."
    },
    {
      "id": "follow-bait",
      "regex": "(?i)\\b(?:segui(?:mi)? per (?:altri|più)|tagga (?:qualcuno|un amico|un'amica)|metti (?:un )?(?:like|cuoricino)|doppio tap|condividi (?:questo )?(?:se|con chi)|commenta (?:qui sotto )?se)\\b",
      "name": "Esca da riflesso per follow o tag",
      "fix": "Chiedi l'unica azione che questo post si merita. La richiesta generica abitua il pubblico a ignorarle tutte."
    },
    {
      "id": "potenziale",
      "regex": "(?i)\\b(?:sblocca|libera|scatena|svela)\\w*\\s+(?:il\\s+(?:tuo\\s+)?)?(?:vero\\s+)?potenziale\\b|\\blivello successivo\\b|\\bsalto di livello\\b|\\bal prossimo livello\\b",
      "name": "\"Sblocca il tuo potenziale\" / \"livello successivo\"",
      "fix": "Di' quale risultato preciso, in quanto tempo. Questa frase non promette niente."
    },
    {
      "id": "cliche-agg",
      "regex": "(?i)\\b(?:all'avanguardia|a 360 gradi|a tutto tondo|mozzafiato|imperdibil[ei]|da non perdere|must[- ]have|d'impatto|tesoro nascosto|tesori nascosti)\\b",
      "name": "Aggettivo o locuzione da brochure",
      "fix": "Sostituisci con un fatto verificabile: un numero, un nome, un prezzo."
    }
  ]
}
